# Copy to .env and replace placeholders. Never commit .env.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=khmer_moon_calendar
POSTGRES_USER=kmc
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# --- Backend ---
# Outside Docker the backend falls back to a local SQLite file if DATABASE_URL is unset.
# DATABASE_URL=postgresql+psycopg://kmc:<password>@localhost:5432/khmer_moon_calendar
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console
CORS_ORIGINS=http://localhost:3000
TIMEZONE=Asia/Phnom_Penh

# --- Frontend ---
# Server-side URL of the backend (http://backend:8087 inside Docker).
API_INTERNAL_URL=http://localhost:8087
# Public URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
